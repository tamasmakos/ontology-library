{"id": "skos", "nodes": [{"id": "http://www.w3.org/1999/02/22-rdf-syntax-ns#List", "iri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#List", "label": "List", "description": null, "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/1999/02/22-rdf-syntax-ns#List"}}, {"id": "http://www.w3.org/2000/01/rdf-schema#label", "iri": "http://www.w3.org/2000/01/rdf-schema#label", "label": "label", "description": null, "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2000/01/rdf-schema#label"}}, {"id": "http://www.w3.org/2004/02/skos/core#Collection", "iri": "http://www.w3.org/2004/02/skos/core#Collection", "label": "Collection", "description": "A meaningful collection of concepts.", "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#Collection"}}, {"id": "http://www.w3.org/2004/02/skos/core#Concept", "iri": "http://www.w3.org/2004/02/skos/core#Concept", "label": "Concept", "description": "An idea or notion; a unit of thought.", "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#Concept"}}, {"id": "http://www.w3.org/2004/02/skos/core#ConceptScheme", "iri": "http://www.w3.org/2004/02/skos/core#ConceptScheme", "label": "Concept Scheme", "description": "A set of concepts, optionally including statements about semantic relationships between those concepts.", "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#ConceptScheme"}}, {"id": "http://www.w3.org/2004/02/skos/core#OrderedCollection", "iri": "http://www.w3.org/2004/02/skos/core#OrderedCollection", "label": "Ordered Collection", "description": "An ordered collection of concepts, where both the grouping and the ordering are meaningful.", "types": ["class"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#OrderedCollection"}}, {"id": "http://www.w3.org/2004/02/skos/core#altLabel", "iri": "http://www.w3.org/2004/02/skos/core#altLabel", "label": "alternative label", "description": "The range of skos:altLabel is the class of RDF plain literals.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#altLabel"}}, {"id": "http://www.w3.org/2004/02/skos/core#broadMatch", "iri": "http://www.w3.org/2004/02/skos/core#broadMatch", "label": "has broader match", "description": "skos:broadMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#broadMatch"}}, {"id": "http://www.w3.org/2004/02/skos/core#broader", "iri": "http://www.w3.org/2004/02/skos/core#broader", "label": "has broader", "description": "Broader concepts are typically rendered as parents in a concept hierarchy (tree).", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#broader"}}, {"id": "http://www.w3.org/2004/02/skos/core#broaderTransitive", "iri": "http://www.w3.org/2004/02/skos/core#broaderTransitive", "label": "has broader transitive", "description": "skos:broaderTransitive is a transitive superproperty of skos:broader.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#broaderTransitive"}}, {"id": "http://www.w3.org/2004/02/skos/core#changeNote", "iri": "http://www.w3.org/2004/02/skos/core#changeNote", "label": "change note", "description": "A note about a modification to a concept.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#changeNote"}}, {"id": "http://www.w3.org/2004/02/skos/core#closeMatch", "iri": "http://www.w3.org/2004/02/skos/core#closeMatch", "label": "has close match", "description": "skos:closeMatch is used to link two concepts that are sufficiently similar that they can be used interchangeably in some information retrieval applications. In order to avoid the possibility of \"compound errors\" when combining mappings across more than two concept schemes, skos:closeMatch is not declared to be a transitive property.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#closeMatch"}}, {"id": "http://www.w3.org/2004/02/skos/core#definition", "iri": "http://www.w3.org/2004/02/skos/core#definition", "label": "definition", "description": "A statement or formal explanation of the meaning of a concept.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#definition"}}, {"id": "http://www.w3.org/2004/02/skos/core#editorialNote", "iri": "http://www.w3.org/2004/02/skos/core#editorialNote", "label": "editorial note", "description": "A note for an editor, translator or maintainer of the vocabulary.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#editorialNote"}}, {"id": "http://www.w3.org/2004/02/skos/core#exactMatch", "iri": "http://www.w3.org/2004/02/skos/core#exactMatch", "label": "has exact match", "description": "skos:exactMatch is disjoint with each of the properties skos:broadMatch and skos:relatedMatch.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#exactMatch"}}, {"id": "http://www.w3.org/2004/02/skos/core#example", "iri": "http://www.w3.org/2004/02/skos/core#example", "label": "example", "description": "An example of the use of a concept.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#example"}}, {"id": "http://www.w3.org/2004/02/skos/core#hasTopConcept", "iri": "http://www.w3.org/2004/02/skos/core#hasTopConcept", "label": "has top concept", "description": "Relates, by convention, a concept scheme to a concept which is topmost in the broader/narrower concept hierarchies for that scheme, providing an entry point to these hierarchies.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#hasTopConcept"}}, {"id": "http://www.w3.org/2004/02/skos/core#hiddenLabel", "iri": "http://www.w3.org/2004/02/skos/core#hiddenLabel", "label": "hidden label", "description": "The range of skos:hiddenLabel is the class of RDF plain literals.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#hiddenLabel"}}, {"id": "http://www.w3.org/2004/02/skos/core#historyNote", "iri": "http://www.w3.org/2004/02/skos/core#historyNote", "label": "history note", "description": "A note about the past state/use/meaning of a concept.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#historyNote"}}, {"id": "http://www.w3.org/2004/02/skos/core#inScheme", "iri": "http://www.w3.org/2004/02/skos/core#inScheme", "label": "is in scheme", "description": "Relates a resource (for example a concept) to a concept scheme in which it is included.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#inScheme"}}, {"id": "http://www.w3.org/2004/02/skos/core#mappingRelation", "iri": "http://www.w3.org/2004/02/skos/core#mappingRelation", "label": "is in mapping relation with", "description": "These concept mapping relations mirror semantic relations, and the data model defined below is similar (with the exception of skos:exactMatch) to the data model defined for semantic relations. A distinct vocabulary is provided for concept mapping relations, to provide a convenient way to differentiate links within a concept scheme from links between concept schemes. However, this pattern of usage is not a formal requirement of the SKOS data model, and relies on informal definitions of best practice.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#mappingRelation"}}, {"id": "http://www.w3.org/2004/02/skos/core#member", "iri": "http://www.w3.org/2004/02/skos/core#member", "label": "has member", "description": "Relates a collection to one of its members.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#member"}}, {"id": "http://www.w3.org/2004/02/skos/core#memberList", "iri": "http://www.w3.org/2004/02/skos/core#memberList", "label": "has member list", "description": "For any resource, every item in the list given as the value of the\n      skos:memberList property is also a value of the skos:member property.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#memberList"}}, {"id": "http://www.w3.org/2004/02/skos/core#narrowMatch", "iri": "http://www.w3.org/2004/02/skos/core#narrowMatch", "label": "has narrower match", "description": "skos:narrowMatch is used to state a hierarchical mapping link between two conceptual resources in different concept schemes.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#narrowMatch"}}, {"id": "http://www.w3.org/2004/02/skos/core#narrower", "iri": "http://www.w3.org/2004/02/skos/core#narrower", "label": "has narrower", "description": "Narrower concepts are typically rendered as children in a concept hierarchy (tree).", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#narrower"}}, {"id": "http://www.w3.org/2004/02/skos/core#narrowerTransitive", "iri": "http://www.w3.org/2004/02/skos/core#narrowerTransitive", "label": "has narrower transitive", "description": "skos:narrowerTransitive is a transitive superproperty of skos:narrower.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#narrowerTransitive"}}, {"id": "http://www.w3.org/2004/02/skos/core#notation", "iri": "http://www.w3.org/2004/02/skos/core#notation", "label": "notation", "description": "A notation, also known as classification code, is a string of characters such as \"T58.5\" or \"303.4833\" used to uniquely identify a concept within the scope of a given concept scheme.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#notation"}}, {"id": "http://www.w3.org/2004/02/skos/core#note", "iri": "http://www.w3.org/2004/02/skos/core#note", "label": "note", "description": "A general note, for any purpose.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#note"}}, {"id": "http://www.w3.org/2004/02/skos/core#prefLabel", "iri": "http://www.w3.org/2004/02/skos/core#prefLabel", "label": "preferred label", "description": "A resource has no more than one value of skos:prefLabel per language tag, and no more than one value of skos:prefLabel without language tag.", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#prefLabel"}}, {"id": "http://www.w3.org/2004/02/skos/core#related", "iri": "http://www.w3.org/2004/02/skos/core#related", "label": "has related", "description": "skos:related is disjoint with skos:broaderTransitive", "types": ["property"], "provenance": {"source_ontology_id": "skos", "original_iri": "http://www.w3.org/2004/02/skos/core#related"}}, {"id": "http://www.w3.org/2004/02/skos/core#relatedMatch", "iri": "http://www.w3.org/2004/02/skos/core#relatedMatch", "label": 